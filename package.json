    "runtime:collector:adapt": "node scripts/runtime-collector-adapter.js",
    "runtime:checkout:collect": "node scripts/collect-git-checkout-runtime-evidence.js",
    "runtime:application:collect": "node scripts/collect-application-runtime-evidence.js",
    "runtime:container:collect": "node scripts/collect-docker-container-runtime-evidence.js",
    "runtime:process:collect": "node scripts/collect-process-runtime-evidence.js",
    "runtime:health:evidence": "node scripts/runtime-health-evidence.js",
    "audit:runtime-health": "node scripts/audit-runtime-health.js",
    "runtime:smoke": "node scripts/run-synthetic-smoke-tests.js",
    "runtime:frontend": "node scripts/run-frontend-runtime-checks.js",
