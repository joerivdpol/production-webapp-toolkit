{
  "name": "production-webapp-toolkit",
  "version": "1.1.0",
  "private": true,
  "description": "Reusable CI quality gates, repository auditing, and AI-agent workflow templates for TypeScript web applications.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "audit": "node scripts/audit-repository.js",
    "audit:all": "node scripts/audit-all-repositories.js",
    "audit:profiled": "node scripts/audit-profiled-repository.js",
    "audit:ecosystem": "node scripts/audit-profiled-ecosystem.js",
    "audit:python": "node scripts/audit-python-service.js",
    "audit:drift": "node scripts/audit-dependency-drift.js",
    "audit:safety": "node scripts/audit-public-repo-safety.js",
    "audit:architecture": "node scripts/audit-architecture-compliance.js",
    "audit:git-governance": "node scripts/audit-git-governance.js",
    "audit:production-baseline": "node scripts/audit-production-baseline.js",
    "audit:deployment": "node scripts/audit-deployment-verification.js",
    "audit:repository-status": "node scripts/audit-repository-status.js",
    "audit:ecosystem-status": "node scripts/audit-ecosystem-status.js",
    "audit:ci": "node scripts/audit-ci-verification.js",
    "audit:release": "node scripts/audit-release-readiness.js",
    "runtime:evidence": "node scripts/runtime-evidence.js",
    "ci:evidence": "node scripts/ci-evidence.js",
    "bootstrap": "node scripts/bootstrap-repository.js",
    "remediation:plan": "node scripts/plan-remediation.js",
    "remediation:apply": "node scripts/apply-remediation.js",
    "build": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run lint",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "release:verify": "bun run audit:safety . && bun run check && bun run build && bun run audit:release",
    "ci:evidence:github-actions": "node scripts/github-actions-ci-evidence.js",
    "ci:evidence:github-actions:collect": "node scripts/collect-github-actions-ci-evidence.js",
    "audit:github-protection": "node scripts/audit-github-protection.js",
    "audit:env-contract": "node scripts/audit-environment-contract.js",
    "audit:env-exposure": "node scripts/audit-client-env-exposure.js",
    "audit:migration-safety": "node scripts/audit-migration-safety.js",
    "schema:snapshot": "node scripts/database-schema-snapshot.js",
    "schema:snapshot:postgres:collect": "node scripts/collect-postgres-schema-snapshot.js",
    "audit:schema-drift": "node scripts/audit-database-schema-drift.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.17",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
}
