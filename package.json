    "vulnerability:github:collect": "node scripts/collect-github-dependabot-evidence.js",
    "audit:vulnerabilities": "node scripts/audit-vulnerabilities.js",
    "sbom:generate": "node scripts/generate-sbom.js",
    "license:evidence": "node scripts/license-evidence.js",
    "license:collect:installed": "node scripts/collect-installed-license-evidence.js",
    "audit:licenses": "node scripts/audit-licenses.js",
    "audit:reproducibility": "node scripts/audit-build-reproducibility.js",
    "artifact:provenance": "node scripts/artifact-provenance.js",
    "audit:artifact-provenance": "node scripts/audit-artifact-provenance.js",
    "change:evidence": "node scripts/change-surface-evidence.js",
    "audit:release-risk": "node scripts/audit-release-risk.js",
    "change:analyze": "node scripts/analyze-changed-surface.js",
    "test:select": "node scripts/select-tests.js",
    "audit:flaky-tests": "node scripts/audit-flaky-tests.js",
    "coverage:evidence": "node scripts/coverage-comparison-evidence.js",
    "audit:coverage": "node scripts/audit-coverage-regression.js",
    "orphan:evidence": "node scripts/orphan-evidence.js",
    "orphan:collect:static": "node scripts/collect-static-orphan-evidence.js",
    "audit:orphans": "node scripts/audit-orphans.js",
    "audit:hygiene": "node scripts/audit-repository-hygiene.js",
    "audit:docs": "node scripts/audit-documentation-drift.js",
    "audit:ownership": "node scripts/audit-codeowners-ownership.js",
    "runtime:seo": "node scripts/run-seo-production-checks.js",
    "audit:localization": "node scripts/audit-localization-completeness.js",
    "route:inventory": "node scripts/route-inventory.js",
    "audit:route-coverage": "node scripts/audit-route-coverage.js",
    "audit:authorization": "node scripts/audit-authorization-policy.js",
    "audit:webhook-safety": "node scripts/audit-webhook-safety.js",
    "audit:payment-integrity": "node scripts/audit-payment-integrity.js",
    "booking:integrity:evidence": "node scripts/booking-integrity-evidence.js",
    "audit:booking-integrity": "node scripts/audit-booking-integrity.js",
    "audit:jobs": "node scripts/audit-job-scheduler.js",
    "backup:evidence": "node scripts/backup-readiness-evidence.js",
    "audit:backup-readiness": "node scripts/audit-backup-readiness.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.17",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
