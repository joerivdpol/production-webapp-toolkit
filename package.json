{
  "name": "production-webapp-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable CI quality gates, repository auditing, and AI-agent workflow templates for TypeScript web applications.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "node scripts/audit-repository.js .",
    "build": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run lint",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.17",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
}
