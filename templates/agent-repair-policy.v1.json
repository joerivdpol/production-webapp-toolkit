{
  "version": 1,
  "repository": "example-repository",
  "allowedPathPatterns": [
    "src/**"
  ],
  "deniedPathPatterns": [
    "test/**",
    ".github/**",
    "AGENTS.md"
  ],
  "allowedOperations": [
    "MODIFY",
    "CREATE"
  ],
  "applyMode": "PROPOSE_ONLY",
  "maxFiles": 3,
  "maxFileBytes": 65536,
  "maxTotalBytes": 131072,
  "requiredChecks": [
    "test",
    "typecheck",
    "lint"
  ]
}
